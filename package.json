{
	"name": "up-a-pawn",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vite build && node scripts/build-offline.mjs",
		"preview": "node scripts/serve-build.mjs",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"cap:sync": "bun run build && cap sync",
		"cap:android": "cap open android",
		"cap:ios": "cap open ios",
		"format": "prettier --write .",
		"engine:build": "node scripts/build-engine.mjs",
		"engine:test": "node --experimental-strip-types --test tests/engine*.test.ts",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/app": "8.1.2",
		"@capacitor/core": "8.5.3",
		"@capacitor/ios": "8.5.3",
		"@capacitor/keyboard": "8.0.6",
		"@fontsource-variable/dm-sans": "5.3.0",
		"@fontsource/dm-serif-display": "5.3.0",
		"bits-ui": "2.20.2",
		"chess.js": "1.4.0",
		"lucide-svelte": "1.0.1"
	},
	"devDependencies": {
		"@capacitor/cli": "8.5.3",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "bun@1.4.3",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
