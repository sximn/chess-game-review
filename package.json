{
	"name": "up-a-pawn",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vite build && node scripts/build-offline.mjs",
		"cf:package": "wrangler build --experimental-new-config --experimental-cf-build-output --env production",
		"cf:check": "cf deploy --prebuilt --mode production --dry-run",
		"cf:deploy": "cf deploy --prebuilt --mode production",
		"preview": "bun scripts/serve-build.mjs",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test tests/*.test.ts",
		"cap:sync": "cap sync",
		"cap:build:sync": "bun run build && bun run cap:sync",
		"cap:android": "cap open android",
		"cap:ios": "cap open ios",
		"format": "prettier --write .",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@capacitor/android": "8.6.0",
		"@capacitor/app": "8.1.2",
		"@capacitor/core": "8.6.0",
		"@capacitor/ios": "8.6.0",
		"@capacitor/keyboard": "8.0.6",
		"@fontsource-variable/dm-sans": "5.3.0",
		"@fontsource/dm-serif-display": "5.3.0",
		"bits-ui": "2.20.6",
		"chess-engine-kit": "0.1.0",
		"chess.js": "1.4.0",
		"lucide-svelte": "1.0.1"
	},
	"devDependencies": {
		"@capacitor/cli": "8.6.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"cf": "1.0.0-beta.27",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.6",
		"wrangler": "4.158.0"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || ^26.12.0"
	},
	"packageManager": "bun@1.4.3",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
